<idea-plugin require-restart="false">
    <id>com.tripleh.devtoolbox</id>
    <name>DevToolbox</name>
    <vendor url="https://github.com/Triple3h">triple3h</vendor>

    <!-- Product and plugin compatibility requirements -->
    <!-- https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends optional="true" config-file="pluginKotlin.xml">org.jetbrains.kotlin</depends>

    <actions>
        <action id="GoToRequestMapping" class="com.tripleh.devtoolbox.GoToRequestMappingAction"
          text="Request Mapping" description="Request mapping">
            <add-to-group group-id="GoToTargetEx" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
        </action>
    </actions>

    <extensionPoints>
        <extensionPoint name="requestMappingContributor" interface="com.intellij.navigation.ChooseByNameContributor"/>
    </extensionPoints>

    <extensions  defaultExtensionNs="com.intellij">
        <searchEverywhereContributor implementation="com.tripleh.devtoolbox.RequestMappingGoToContributor$Factory"/>
        <toolWindow id="Dev Toolbox" anchor="right" factoryClass="com.tripleh.devtoolbox.tools.DevToolboxToolWindowFactory" icon="/icons/search.png"/>
    </extensions>

    <extensions defaultExtensionNs="com.tripleh.devtoolbox">
        <requestMappingContributor implementation="com.tripleh.devtoolbox.contributor.JavaRequestMappingContributor"/>
    </extensions>
</idea-plugin>
